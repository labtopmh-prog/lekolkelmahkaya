{
  "entities": {
    "Book": {
      "title": "Book",
      "description": "A literary book in the Every Word Is a Story digital library.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "author": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": { "type": "string", "enum": ["أدب وخواطر", "روايات قصيرة", "حكايات ملهمة", "تنمية وبصيرة", "شعر ونثر"] },
        "synopsis": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "coverColor": { "type": "string", "minLength": 3, "maxLength": 40 },
        "coverImage": { "type": "string", "minLength": 0, "maxLength": 500 },
        "readingMinutes": { "type": "number" },
        "featured": { "type": "boolean" },
        "chapters": { "type": "array" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "author", "category", "synopsis", "coverColor", "readingMinutes", "featured", "chapters", "createdBy", "createdAt", "updatedAt"]
    },
    "Quote": {
      "title": "Quote",
      "description": "An inspiring quote or heart-touching word curated for the library.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "text": { "type": "string", "minLength": 4, "maxLength": 600 },
        "author": { "type": "string", "minLength": 1, "maxLength": 120 },
        "sourceTitle": { "type": "string", "minLength": 0, "maxLength": 160 },
        "category": { "type": "string", "enum": ["كلمات تلمس القلب", "اقتباس اليوم", "حكم وأقوال", "تأملات هادئة"] },
        "mood": { "type": "string", "minLength": 1, "maxLength": 60 },
        "isDailyHighlight": { "type": "boolean" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "text", "author", "category", "mood", "isDailyHighlight", "createdBy", "createdAt", "updatedAt"]
    },
    "TeamMember": {
      "title": "TeamMember",
      "description": "Member of the Every Word Is a Story library editorial and administrative team.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "roleTitle": { "type": "string", "minLength": 1, "maxLength": 120 },
        "roleLevel": { "type": "string", "enum": ["super_admin", "chief_assistant", "assistant"] },
        "bio": { "type": "string", "minLength": 1, "maxLength": 500 },
        "portraitUrl": { "type": "string", "minLength": 1, "maxLength": 500 },
        "accentTone": { "type": "string", "minLength": 1, "maxLength": 40 },
        "sortOrder": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "roleTitle", "roleLevel", "bio", "portraitUrl", "accentTone", "sortOrder", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User reading preferences, synced theme, favorites, and progress across web and mobile.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "minLength": 3, "maxLength": 200 },
        "theme": { "type": "string", "enum": ["cream", "rose", "lavender", "sky", "mint", "peach"] },
        "fontSize": { "type": "string", "enum": ["small", "medium", "large"] },
        "notificationsEnabled": { "type": "boolean" },
        "favoriteBookIds": { "type": "array" },
        "favoriteQuoteIds": { "type": "array" },
        "readingProgress": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "theme", "fontSize", "notificationsEnabled", "favoriteBookIds", "favoriteQuoteIds", "readingProgress", "updatedAt"]
    },
    "RoleAssignment": {
      "title": "RoleAssignment",
      "description": "Strict RBAC role mapping controlled solely by the Super Admin.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "minLength": 3, "maxLength": 200 },
        "role": { "type": "string", "enum": ["super_admin", "assistant", "reader"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "assignedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "title", "assignedBy", "updatedAt"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Reader inquiry or feedback message sent through the Contact Us page.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "email": { "type": "string", "minLength": 5, "maxLength": 200 },
        "subject": { "type": "string", "minLength": 2, "maxLength": 160 },
        "message": { "type": "string", "minLength": 5, "maxLength": 2000 },
        "status": { "type": "string", "enum": ["new", "reviewed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "subject", "message", "status", "createdAt"]
    }
  },
  "firestore": {
    "/books/{bookId}": {
      "schema": { "$ref": "#/entities/Book" },
      "description": "Publicly readable literary books managed by super admin and assistants."
    },
    "/quotes/{quoteId}": {
      "schema": { "$ref": "#/entities/Quote" },
      "description": "Publicly readable daily quotes and heart-touching words."
    },
    "/team/{memberId}": {
      "schema": { "$ref": "#/entities/TeamMember" },
      "description": "Library team members managed exclusively by the super admin."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile, synced preferences, favorites, and reading progress."
    },
    "/roles/{userId}": {
      "schema": { "$ref": "#/entities/RoleAssignment" },
      "description": "RBAC role records manageable only by the super admin."
    },
    "/contactMessages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Contact messages submitted by visitors and reviewed by the library team."
    }
  }
}
